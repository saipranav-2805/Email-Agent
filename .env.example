# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Ingestion
COLLEGE_WEBHOOK_API_KEY=your_super_secret_college_ingest_key_here
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_token_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
APP_BASE_URL=https://your-app.onrender.com

# Database (PostgreSQL / Supabase with automatic SQLite fallback)
DATABASE_URL=sqlite+aiosqlite:///./placement_agent.db
# Example Supabase production URL:
# DATABASE_URL=postgresql+asyncpg://postgres:password@db.xyz.supabase.co:5432/postgres

# Google GenAI (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEEP_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash-lite

# Fallback LLM (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google APIs (Gmail & Calendar OAuth for Personal Mail & Alarm)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_oauth_refresh_token
PERSONAL_GMAIL_ADDRESS=your_personal_email@gmail.com

# Candidate Profile Path
PROFILE_PATH=config/profile.json

# Timezone (Default: Asia/Kolkata / IST)
TIMEZONE=Asia/Kolkata
